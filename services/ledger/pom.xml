<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.elyonar</groupId>
        <artifactId>fincore</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ledger</artifactId>
    <name>fincore :: ledger</name>
    <description>
        Ledger Service — the crown jewel (PRD §4.1). Owns the chart of accounts, postings,
        balances, idempotency registry, and invariant checks. Double-entry, immutable,
        idempotent. Never contains fee logic, product rules, external calls, or orchestration.
    </description>

    <!--
        Kept deliberately small. architecture.md treats this dependency list as an
        architectural control: there is no HTTP client and no messaging consumer
        here, and a reviewer can confirm that by reading this file. ArchUnit
        enforces the same rule against the code.
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Actuator gives the container a real readiness/liveness signal, so
            compose and any future orchestrator wait for "actually serving"
            rather than "process started". Domain endpoints arrive with the
            implementation (services/ledger/docs/api.md).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            JDBC, not JPA. The posting algorithm is written in terms of
            SELECT ... FOR UPDATE in a stated lock order, deterministic
            statement ordering, and unique-index conflicts as the idempotency
            arbiter. An ORM's flush ordering and identity map would obscure
            exactly the behaviour the design depends on being explicit.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            OpenAPI is generated from the code rather than hand-written, so the
            published contract cannot drift from what the service actually
            serves. api.md remains the agreed *design*; this is its executable
            reflection.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.0</version>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!--
            Spring Boot 4 split autoconfiguration out of spring-boot-autoconfigure
            into per-technology modules. Without this, flyway-core sits on the
            classpath and simply never runs — the application starts happily
            against an unmigrated database, which is a far worse failure than a
            missing dependency error.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Spring Boot 4 split test autoconfiguration by technology in the same way it split
            runtime autoconfiguration: @AutoConfigureMockMvc lives here, not in
            spring-boot-test-autoconfigure.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            ArchUnit turns the AGENTS.md hard rules into failing builds instead
            of review comments. A contributor (human or AI) cannot argue with a
            red test; they can argue with a paragraph.
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <!-- 1.4.x or newer: earlier ASM cannot read Java 25 bytecode (major 69)
                 and silently imports zero classes, so every rule passes vacuously. -->
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
