<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.elyonar</groupId>
        <artifactId>core</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>app</artifactId>
    <name>fincore :: core :: app</name>
    <description>
        Assembles the three modules into one deployable: wiring, migrations, the outbox relay
        and the saga worker. No domain logic. It is the only module that sees all three
        implementations, which is why the boundary tests live here.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.elyonar</groupId>
            <artifactId>customer</artifactId>
        </dependency>
        <dependency>
            <groupId>org.elyonar</groupId>
            <artifactId>product</artifactId>
        </dependency>
        <dependency>
            <groupId>org.elyonar</groupId>
            <artifactId>orchestration</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
            The OpenAPI document is generated from the code. docs/api.md stays the agreed design;
            this is its executable reflection, and it cannot describe an endpoint the service does
            not serve — which is the failure mode of every hand-written API document eventually.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            The module boundaries are enforced by the build rather than by review. This matters
            more here than it would with separate api artifacts, because with one module per
            domain the compiler will happily let orchestration import product's internals —
            ArchUnit is what stops it (CHANGELOG 1.1.0).
        -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <!-- 1.4.x or newer: earlier ASM cannot read Java 25 bytecode (major 69) and
                 silently imports zero classes, so every rule passes vacuously. Pinned to
                 1.3.0 here first, and the empty-import canary caught it on the first run —
                 which is the entire reason that rule exists. -->
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
