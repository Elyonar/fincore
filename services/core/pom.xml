<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.elyonar</groupId>
        <artifactId>fincore</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>core</artifactId>
    <packaging>pom</packaging>
    <name>fincore :: core</name>
    <description>
        Core Service — transaction orchestration, the organizational model and staff
        administration. One database, one schema per module, one database role per module. The only
        caller of the Ledger's write API.

        Customer and Product left this deployable under ADR 0020, which fired two of ADR 0006's own
        extraction triggers. Core is now a client of both over HTTP and links against neither.
    </description>

    <!--
        One Maven module per domain, so dependency direction is declared rather than implied:
        nothing depends on orchestration, and a cycle is a build failure instead of a review
        comment. Orchestration's dependencies on Customer and Product are now network calls behind
        ports it owns, so the compiler can no longer enforce that direction — ADR 0020 explains why
        the ports and their client model live here rather than in a shared jar.

        Within a module, `api` is the published surface and `internal` is everything else. A
        consumer may reference another module's `api` package and never its `internal` one —
        enforced by ArchUnit (ModuleBoundaryTest) and, for data, by one database role per schema
        with no grants on its neighbours.

        Splitting each domain further into separate api and impl artifacts would let the
        compiler enforce that too. It was tried and reverted as more folders than the boundary
        was worth at four modules; see CHANGELOG 1.1.0, which records what the trade actually
        costs rather than implying nothing changed.
    -->
    <modules>
        <module>organization</module>
        <module>orchestration</module>
        <module>admin</module>
        <module>app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.elyonar</groupId>
                <artifactId>organization</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.elyonar</groupId>
                <artifactId>orchestration</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.elyonar</groupId>
                <artifactId>admin</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
