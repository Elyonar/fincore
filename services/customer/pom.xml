<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.elyonar</groupId>
        <artifactId>fincore</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>customer</artifactId>
    <name>fincore :: customer</name>
    <description>
        Customers and the accounts they hold: profiles, KYC tier and its history, contact details,
        communication consent, and the account-to-product link the money path adjudicates on.
        Extracted from Core because it is the only module holding PII and the one other services
        will consume — lending, partner APIs, any customer-owned surface — none of which have any
        business calling the service that moves money. It never posts money.
    </description>

    <dependencies>
        <!--
            This POM is an architectural control, not a dependency list (service-scaffold §2).
            Two absences are deliberate and a reviewer should be able to see them here:

            * no client onto the money path. Core calls this service; this service never calls
              Core, and it must never learn to — that edge is what would turn an extraction into
              a pair of services that cannot be deployed apart.
            * no ledger client at all. Customer records which ledger account a person holds; it
              never reads a balance and never posts. Product needs one for fee-account
              verification; this service has no equivalent need and should not acquire one.
        -->
        <dependency>
            <groupId>org.elyonar</groupId>
            <artifactId>auth</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.13</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <!-- 1.4.x or newer: earlier ASM cannot read Java 25 bytecode (major 69) and silently
                 imports zero classes, so every rule passes vacuously. Core and Notification were
                 both caught by this; the version is inherited from their scars, not guessed. -->
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
