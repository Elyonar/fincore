# Review is required on anything that defines correctness rather than merely
# implements it: the agreed designs, the platform decisions, the guardrails,
# and every line of money-touching code.

*                                   @nondefyde

# Agreed service designs — changes here are contract amendments.
/services/*/docs/                   @nondefyde

# Platform law.
/docs/adr/                          @nondefyde
/docs/prd.md                        @nondefyde
/docs/conventions/                  @nondefyde

# The guardrails themselves. A PR that weakens a rule should be as visible as
# a PR that breaks one.
/AGENTS.md                          @nondefyde
/.github/workflows/                 @nondefyde
/.github/CODEOWNERS                 @nondefyde
/.cursor/                           @nondefyde
/.github/copilot-instructions.md    @nondefyde

# The ledger. Every kobo the platform moves ends up here.
/services/ledger/                   @nondefyde

# The money path outside the ledger: the only module that may call its write
# API, and the one Core module under the invariant/concurrency merge gate.
/services/core/orchestration/  @nondefyde

# The shared authorization library — every service's enforcement mechanics.
/libs/                              @nondefyde
