<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>org.elyonar</groupId>
    <artifactId>fincore</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>fincore</name>
    <description>
        Open-source, cloud-native, API-first core banking platform for Africa.
        Monorepo: each module under services/ is an independently deployable Spring Boot
        service with its own database (constitution rule: database per service, no shared
        databases, ever). Shared internal libraries live under libs/.
    </description>
    <url>https://github.com/Elyonar/fincore</url>

    <scm>
        <connection>scm:git:https://github.com/Elyonar/fincore.git</connection>
        <developerConnection>scm:git:git@github.com:Elyonar/fincore.git</developerConnection>
        <url>https://github.com/Elyonar/fincore</url>
        <tag>HEAD</tag>
    </scm>

    <licenses>
        <license>
            <name>AGPL-3.0-only</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <modules>
        <module>services/ledger</module>
    </modules>

    <properties>
        <java.version>25</java.version>
    </properties>


</project>
