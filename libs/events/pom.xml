<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.elyonar</groupId>
        <artifactId>fincore</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>events</artifactId>
    <name>fincore :: libs :: events</name>
    <description>
        The event backbone adapters (ADR 0005, ADR 0008). One publisher abstraction and one
        Kafka/RabbitMQ/logging implementation of it, shared by every service that relays an outbox.
        Holds no outbox: a relay reads its own schema and is the service's own business.
    </description>

    <dependencies>
        <!--
            Both client libraries ship and the broker is chosen at runtime, so an operator changes
            backbone without a rebuild and no broker type reaches any domain.
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Test scope only, and deliberately not on the runtime classpath: the envelope is written
            by hand precisely so a mapper cannot make it drift. Asserting the shape of a published
            contract is the one place a real parser earns its keep — a regex over the JSON would
            pass on a document no consumer could read.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
